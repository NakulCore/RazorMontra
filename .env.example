# Application Environment Configuration
APP_NAME=AI Payment Risk Copilot
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/risk_copilot.db

# ML Model Configuration
MODEL_DIR=./ml/artifacts
RISK_THRESHOLD_HIGH=75
RISK_THRESHOLD_MEDIUM=40
RISK_THRESHOLD_CRITICAL=90

# AI / LLM Configuration
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=mock-fintech-v1

# RAG Configuration
POLICY_DIR=./policies

# Payment Provider Configuration
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TEST_MODE=True

# Security
SECRET_KEY=change-this-in-production-risk-copilot-secret-key-313
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
